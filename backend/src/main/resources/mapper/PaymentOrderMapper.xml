<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.github.kokoachino.mapper.PaymentOrderMapper">

    <!-- 根据订单号查询 -->
    <select id="selectByOrderNo" resultType="com.github.kokoachino.model.entity.PaymentOrder">
        SELECT * FROM tw_payment_order WHERE order_no = #{orderNo}
    </select>

    <!-- 原子更新订单状态，避免并发情况下重复入账 -->
    <update id="markPaidIfPending">
        UPDATE tw_payment_order
        SET status = 'paid',
            alipay_trade_no = #{alipayTradeNo},
            paid_at = #{paidAt},
            updated_at = NOW()
        WHERE order_no = #{orderNo}
          AND status = 'pending'
    </update>

</mapper>
